# Copie para .env.pgvector.local e preencha localmente. Não envie a senha pelo chat.
# A URL deve apontar para o banco de destino já existente.
# Exemplo: postgresql://usuario:senha@servidor:5432/lex_clt?sslmode=require
DATABASE_URL=

# Para PostgreSQL local via compose.pgvector.yaml:
POSTGRES_DB=lex_clt
POSTGRES_USER=lex_clt
POSTGRES_PASSWORD=
PGVECTOR_PORT=15432
